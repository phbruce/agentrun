{
  "name": "@agentrun-ai/executor-cli",
  "version": "0.1.2",
  "description": "CLI executor \u2014 runs co-located impl.{mjs,py,sh} via stdin/stdout JSON",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "tsc && ../../scripts/check-leaks.sh $(pwd)/src $(pwd)/dist $(pwd)/package.json"
  },
  "peerDependencies": {
    "@agentrun-ai/core": "^0.5.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phbruce/agentrun.git",
    "directory": "packages/executor-cli"
  },
  "homepage": "https://github.com/phbruce/agentrun"
}